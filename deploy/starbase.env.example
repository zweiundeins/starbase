# /etc/starbase/starbase.env
ADDR=unix:/run/starbase/starbase.sock
BASE_URL=https://starbase.zweiundeins.gmbh
DB_PATH=/var/lib/starbase/starbase.db
REPO_URL=https://github.com/zweiundeins/starbase
# Optional: GitHub OAuth app (callback $BASE_URL/auth/github/callback)
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
# Optional: a read-only token for pull request preview checks (rate limit)
#GITHUB_TOKEN=
