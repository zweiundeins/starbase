# Copy to .env (or export) and adjust.
ADDR=:7331
BASE_URL=http://localhost:7331
DB_PATH=data/starbase.db
REPO_URL=https://github.com/zweiundeins/starbase

# GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Callback URL: $BASE_URL/auth/github/callback
# Without these, dev builds fall back to a fake login at /auth/dev.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
