From 38a712d55753675fd42daaea9fc49f57f1a5a17c Mon Sep 17 00:00:00 2001
From: PD rockets contributor <contributor@users.noreply.github.com>
Date: Tue, 6 Oct 2026 22:09:36 +0000
Subject: [PATCH 54/58] Let a trigger turn off menu items with
 data-menu-disabled

One menu serves many triggers, but an action may not apply to every one of them, such as
moving the first row up. A trigger, or the element that carries its context id, can now
list actions in data-menu-disabled; the copied items with those actions get
aria-disabled, which keyboard navigation and clicks already skip.
---
 rocket/context-menu/client.ts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/rocket/context-menu/client.ts b/rocket/context-menu/client.ts
index 24334bb..530d566 100644
--- a/rocket/context-menu/client.ts
+++ b/rocket/context-menu/client.ts
@@ -148,6 +148,7 @@ function setupMenu(
       content = document.createElement("div");
       content.setAttribute("data-menu-content", "");
       content.append(bindTemplate(template, { ...triggerParams(source), ...context, contextId }));
+      disableItems(content, source);
       host.append(content);
     } else content = live ?? host;
     // Submenus stay hidden until they open.
@@ -311,6 +312,15 @@ function triggerParams(trigger: HTMLElement): Record<string, string> {
   return params;
 }
 
+/** Turn off the copied items whose data-action the trigger, or its context element, lists in data-menu-disabled. */
+function disableItems(content: HTMLElement, trigger: HTMLElement): void {
+  const actions = [trigger.closest<HTMLElement>("[data-context-id]"), trigger].flatMap(
+    (element) => element?.dataset.menuDisabled?.split(" ").filter(Boolean) ?? [],
+  );
+  for (const item of content.querySelectorAll<HTMLElement>("[data-action]"))
+    if (actions.includes(item.dataset.action!)) item.setAttribute("aria-disabled", "true");
+}
+
 function showSheet(menu: HTMLElement): () => void {
   menu.showPopover();
   return () => {};
