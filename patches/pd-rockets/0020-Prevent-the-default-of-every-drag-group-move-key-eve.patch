From 981543e36def0c342d6c04acd2f698025453ef7b Mon Sep 17 00:00:00 2001
From: PD rockets contributor <contributor@users.noreply.github.com>
Date: Tue, 6 Oct 2026 22:07:18 +0000
Subject: [PATCH 20/22] Prevent the default of every drag group move key, even
 with no list that way

Alt+ArrowLeft on an item in the leftmost list was left to the browser, which goes back in history on Windows and Linux. A move key on an item is the group's, whether or not the item can move.
---
 rocket/drag-group/client.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/rocket/drag-group/client.ts b/rocket/drag-group/client.ts
index 623b3c4..d02874f 100644
--- a/rocket/drag-group/client.ts
+++ b/rocket/drag-group/client.ts
@@ -133,6 +133,7 @@ rocket(dragGroupContract.tag, {
       }
       const { x: horizontal, y: vertical } = keyboard.direction(event, "move");
       if (!horizontal && !vertical) return;
+      event.preventDefault();
       const sourceList = item.closest<HTMLElement>(listSelector);
       const stagedTarget = staging.current?.itemId === id ? staging.current.target : null;
       const currentList = stagedTarget?.list ?? sourceList;
@@ -152,7 +153,6 @@ rocket(dragGroupContract.tag, {
         before = candidates[nextPosition]?.dataset.dragItem ?? "";
       }
       const target = { list, toList: list.dataset.dropList ?? "", before };
-      event.preventDefault();
       staging.set(item, { itemId: id, target }, event);
       mark(target);
     };
-- 
