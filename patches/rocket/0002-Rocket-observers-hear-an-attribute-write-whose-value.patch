From af17e762a16abdcffa875f66f6484dcaf4e29d53 Mon Sep 17 00:00:00 2001
From: Michael Bolli <michael@zweiundeins.gmbh>
Date: Tue, 10 Nov 2026 05:20:39 +0000
Subject: [PATCH 2/2] Rocket: observers hear an attribute write whose value
 decodes the same

---
 library/src/rocket/runtime.ts | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/library/src/rocket/runtime.ts b/library/src/rocket/runtime.ts
index 1ca2ea26..efe1f4ef 100644
--- a/library/src/rocket/runtime.ts
+++ b/library/src/rocket/runtime.ts
@@ -1157,10 +1157,14 @@ export function rocket<
     #setProp(
       name: keyof InferProps<Defs> & string,
       nextValue: InferProps<Defs>[typeof name],
+      // The attribute's text changed: observers hear it even if the value is the
+      // same (checked="false" written onto a toggle that had no checked attribute).
+      written = false,
     ) {
-      if (Object.is(this.#props[name], nextValue)) return
+      const same = Object.is(this.#props[name], nextValue)
+      if (same && !written) return
       this.#props[name] = nextValue
-      this.#formPropsChanged?.()
+      if (!same) this.#formPropsChanged?.()
       const changes = { [name]: nextValue } as Partial<InferProps<Defs>>
       for (const observer of this.#propObservers) {
         if (observer.names === null || observer.names.has(name)) {
@@ -1169,6 +1173,7 @@ export function rocket<
       }
 
       // Notify prop observers synchronously, then optionally queue a render so a burst of writes still collapses into one render.
+      if (same) return
       if (
         typeof renderOnPropChange === 'function'
           ? renderOnPropChange({
@@ -1806,7 +1811,11 @@ export function rocket<
         this.#pendingInitialAttrValues.delete(name)
         return
       }
-      this.#setProp(propName, attributePropValue(propName, newValue))
+      this.#setProp(
+        propName,
+        attributePropValue(propName, newValue),
+        oldValue !== newValue,
+      )
     }
 
     disconnectedCallback() {
-- 
2.47.3

