{
  "tag": "sb-tabs",
  "props": [
    {
      "name": "labels",
      "attribute": "labels",
      "type": "array",
      "default": [
        "Home",
        "Docs",
        "API"
      ],
      "required": false,
      "docs": {
        "description": "Tab labels, as a JSON array."
      }
    },
    {
      "name": "selected",
      "attribute": "selected",
      "type": "number",
      "default": 0,
      "required": false,
      "docs": {
        "description": "Index of the initially selected tab."
      }
    }
  ],
  "slots": [
    {
      "name": "<label-slug>",
      "description": "Panel content per tab, e.g. slot=\"docs\" for a tab labelled \"Docs\"."
    }
  ],
  "events": [
    {
      "kind": "custom-event",
      "name": "sb-tab-change",
      "bubbles": true,
      "composed": true,
      "description": "detail: { index, label }."
    }
  ]
}
