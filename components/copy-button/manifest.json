{
  "tag": "sb-copy-button",
  "props": [
    {
      "name": "value",
      "attribute": "value",
      "type": "string",
      "default": "",
      "required": false,
      "docs": {
        "description": "The text copied to the clipboard."
      }
    },
    {
      "name": "label",
      "attribute": "label",
      "type": "string",
      "default": "Copy to clipboard",
      "required": false,
      "docs": {
        "description": "Accessible label of the button."
      }
    },
    {
      "name": "copiedLabel",
      "attribute": "copied-label",
      "type": "string",
      "default": "Copied!",
      "required": false,
      "docs": {
        "description": "Shown and announced after copying."
      }
    },
    {
      "name": "failedLabel",
      "attribute": "failed-label",
      "type": "string",
      "default": "Copy failed",
      "required": false,
      "docs": {
        "description": "Shown and announced when the browser refuses the clipboard (no secure context, permissions policy…)."
      }
    },
    {
      "name": "resetMs",
      "attribute": "reset-ms",
      "type": "number",
      "default": 1600,
      "required": false,
      "docs": {
        "description": "How long the copied or failed state lasts, in ms."
      }
    }
  ],
  "slots": [],
  "events": [
    {
      "kind": "custom-event",
      "name": "sb-copy",
      "bubbles": true,
      "composed": true,
      "description": "After copying. detail: { value }."
    },
    {
      "kind": "custom-event",
      "name": "sb-copy-error",
      "bubbles": true,
      "composed": true,
      "description": "When the browser refuses the clipboard write. detail: { value, error } (the error's name, e.g. \"NotAllowedError\")."
    }
  ]
}
