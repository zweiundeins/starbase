{
  "tag": "sb-alert",
  "props": [
    {
      "name": "variant",
      "attribute": "variant",
      "type": "oneOf",
      "default": "info",
      "required": false,
      "values": [
        "info",
        "success",
        "warning",
        "danger"
      ],
      "docs": {
        "description": "Tone of the message."
      }
    },
    {
      "name": "heading",
      "attribute": "heading",
      "type": "string",
      "default": "",
      "required": false,
      "docs": {
        "description": "Bold first line."
      }
    },
    {
      "name": "closable",
      "attribute": "closable",
      "type": "boolean",
      "default": false,
      "required": false,
      "docs": {
        "description": "Show a dismiss button."
      }
    },
    {
      "name": "open",
      "attribute": "open",
      "type": "boolean",
      "default": true,
      "required": false,
      "docs": {
        "description": "Shown. Any change the server makes to the attribute wins, over a dismissal too: open=\"false\" hides it, open or no attribute shows it. Unchanged markup keeps a dismissal. From script: host.open, show(), hide()."
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "The message."
    }
  ],
  "events": [
    {
      "kind": "event",
      "name": "sb-close",
      "bubbles": true,
      "composed": true,
      "description": "The user pressed the close button (not sent for hide(), host.open or the server). No detail."
    }
  ]
}
