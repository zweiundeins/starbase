{
  "tag": "sb-toggle",
  "props": [
    {
      "name": "checked",
      "attribute": "checked",
      "type": "boolean",
      "default": false,
      "required": false,
      "docs": {
        "description": "On or off. A new state from the server wins (send checked=\"false\" to switch it off); the live state is the checked property."
      }
    },
    {
      "name": "disabled",
      "attribute": "disabled",
      "type": "boolean",
      "default": false,
      "required": false,
      "docs": {
        "description": "Disable interaction."
      }
    },
    {
      "name": "label",
      "attribute": "label",
      "type": "string",
      "default": "",
      "required": false,
      "docs": {
        "description": "Visible label next to the switch."
      }
    },
    {
      "name": "size",
      "attribute": "size",
      "type": "oneOf",
      "default": "md",
      "required": false,
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "docs": {
        "description": "Size of the switch."
      }
    },
    {
      "name": "confirm",
      "attribute": "confirm",
      "type": "boolean",
      "default": false,
      "required": false,
      "docs": {
        "description": "Server-confirmed value: :state(pending) while the local value differs from the server's value attribute (see revert())."
      }
    },
    {
      "name": "name",
      "attribute": "name",
      "type": "string",
      "default": "",
      "required": false,
      "docs": {
        "description": "Name reported in sb-change (e.g. the field of a command)."
      }
    }
  ],
  "slots": [],
  "events": [
    {
      "kind": "event",
      "name": "change",
      "bubbles": true,
      "composed": true,
      "description": "After the user flips the switch."
    },
    {
      "kind": "custom-event",
      "name": "sb-change",
      "bubbles": true,
      "composed": true,
      "description": "Same moment. detail: { name, value, checked } (value is the checked state): ready for a command."
    }
  ]
}
