{
  "tag": "sb-code-editor",
  "props": [
    {
      "name": "language",
      "attribute": "language",
      "type": "oneOf",
      "default": "js",
      "required": false,
      "values": [
        "js",
        "html",
        "css"
      ],
      "docs": {
        "description": "Syntax to highlight."
      }
    },
    {
      "name": "value",
      "attribute": "value",
      "type": "string",
      "default": "",
      "required": false,
      "docs": {
        "description": "The code (or a child <script type=\"text/plain\">). A new value from the server replaces it; the live code is the value property."
      }
    },
    {
      "name": "lineNumbers",
      "attribute": "line-numbers",
      "type": "boolean",
      "default": true,
      "required": false,
      "docs": {
        "description": "Show a line-number gutter."
      }
    },
    {
      "name": "tabSize",
      "attribute": "tab-size",
      "type": "number",
      "default": 2,
      "required": false,
      "docs": {
        "description": "Visual width of a tab."
      }
    },
    {
      "name": "readonly",
      "attribute": "readonly",
      "type": "boolean",
      "default": false,
      "required": false,
      "docs": {
        "description": "Make the code read-only."
      }
    },
    {
      "name": "label",
      "attribute": "label",
      "type": "string",
      "default": "",
      "required": false,
      "docs": {
        "description": "Visible label; also the accessible name."
      }
    },
    {
      "name": "confirm",
      "attribute": "confirm",
      "type": "boolean",
      "default": false,
      "required": false,
      "docs": {
        "description": "Server-confirmed value: :state(pending) while the local value differs from the server's value attribute (see revert())."
      }
    },
    {
      "name": "name",
      "attribute": "name",
      "type": "string",
      "default": "",
      "required": false,
      "docs": {
        "description": "Name reported in sb-change (e.g. the field of a command)."
      }
    }
  ],
  "slots": [],
  "events": [
    {
      "kind": "event",
      "name": "input",
      "bubbles": true,
      "composed": true,
      "description": "On every edit (native, re-targeted to the host)."
    },
    {
      "kind": "event",
      "name": "change",
      "bubbles": true,
      "composed": true,
      "description": "When the field loses focus after edits."
    },
    {
      "kind": "custom-event",
      "name": "sb-change",
      "bubbles": true,
      "composed": true,
      "description": "Same moment. detail: { name, value }: ready for a command."
    },
    {
      "kind": "custom-event",
      "name": "sb-run",
      "bubbles": true,
      "composed": true,
      "description": "Ctrl/Cmd+Enter. detail: { value }."
    }
  ]
}
