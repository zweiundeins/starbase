{
  "tag": "sb-code-playground",
  "props": [
    {
      "name": "runner",
      "attribute": "runner",
      "type": "string",
      "default": "/playground/run",
      "required": false,
      "docs": {
        "description": "URL of the sandbox runner page (see the protocol in the docs)."
      }
    },
    {
      "name": "deps",
      "attribute": "deps",
      "type": "json",
      "default": {},
      "required": false,
      "docs": {
        "description": "Other components to load in the preview, as JSON {\"sb-tag\": \"module URL\"}. Tags defined by the edited code are skipped."
      }
    },
    {
      "name": "autoRun",
      "attribute": "auto-run",
      "type": "oneOf",
      "default": true,
      "required": false,
      "values": [
        true,
        false
      ],
      "docs": {
        "description": "Re-run shortly after every edit. On by default: auto-run=\"false\" turns it off."
      }
    },
    {
      "name": "theme",
      "attribute": "theme",
      "type": "string",
      "default": "deep-space",
      "required": false,
      "docs": {
        "description": "Initial preview theme (data-sb-theme)."
      }
    },
    {
      "name": "themes",
      "attribute": "themes",
      "type": "array",
      "default": [
        "deep-space",
        "nebula",
        "terminal",
        "daylight"
      ],
      "required": false,
      "docs": {
        "description": "Themes offered in the picker."
      }
    },
    {
      "name": "delay",
      "attribute": "delay",
      "type": "number",
      "default": 600,
      "required": false,
      "docs": {
        "description": "Auto-run debounce, in ms."
      }
    },
    {
      "name": "base",
      "attribute": "base",
      "type": "string",
      "default": "",
      "required": false,
      "docs": {
        "description": "URL that relative imports in component.js resolve against (the folder its vendored files are served from)."
      }
    },
    {
      "name": "initial",
      "attribute": "initial",
      "type": "json",
      "default": {},
      "required": false,
      "docs": {
        "description": "Initial files as JSON {\"component.js\": \"…\"}, merged over the child scripts (a file here wins); handy for server-rendered pages."
      }
    },
    {
      "name": "typescript",
      "attribute": "typescript",
      "type": "boolean",
      "default": false,
      "required": false,
      "docs": {
        "description": "Offer a TypeScript switch, which renames component.js to component.ts (the runner must accept it). Initial files with component.ts switch it on."
      }
    },
    {
      "name": "diagnostics",
      "attribute": "diagnostics",
      "type": "json",
      "default": {},
      "required": false,
      "docs": {
        "description": "Problems per file, as JSON {\"component.js\": [{line, col, length, message, text}]}, for that file's editor (see sb-code-editor's diagnostics)."
      }
    },
    {
      "name": "filesLabel",
      "attribute": "files-label",
      "type": "string",
      "default": "Files",
      "required": false,
      "docs": {
        "description": "Accessible name of the file tabs."
      }
    },
    {
      "name": "autoLabel",
      "attribute": "auto-label",
      "type": "string",
      "default": "Auto",
      "required": false,
      "docs": {
        "description": "Text of the auto-run switch."
      }
    },
    {
      "name": "themeLabel",
      "attribute": "theme-label",
      "type": "string",
      "default": "Preview theme",
      "required": false,
      "docs": {
        "description": "Accessible name of the theme picker."
      }
    },
    {
      "name": "runLabel",
      "attribute": "run-label",
      "type": "string",
      "default": "Run",
      "required": false,
      "docs": {
        "description": "Text of the run button."
      }
    },
    {
      "name": "runHint",
      "attribute": "run-hint",
      "type": "string",
      "default": "Run (Ctrl+Enter)",
      "required": false,
      "docs": {
        "description": "The run button's tooltip."
      }
    },
    {
      "name": "previewLabel",
      "attribute": "preview-label",
      "type": "string",
      "default": "Preview",
      "required": false,
      "docs": {
        "description": "Title of the preview frame."
      }
    },
    {
      "name": "consoleLabel",
      "attribute": "console-label",
      "type": "string",
      "default": "Console",
      "required": false,
      "docs": {
        "description": "Accessible name of the console, and its text while empty."
      }
    },
    {
      "name": "runningLabel",
      "attribute": "running-label",
      "type": "string",
      "default": "Running…",
      "required": false,
      "docs": {
        "description": "The status while a run starts."
      }
    },
    {
      "name": "ranLabel",
      "attribute": "ran-label",
      "type": "string",
      "default": "Ran in {ms} ms",
      "required": false,
      "docs": {
        "description": "The status after a run: {ms} becomes how long it took, formatted for the page's language."
      }
    },
    {
      "name": "noAnswerLabel",
      "attribute": "no-answer-label",
      "type": "string",
      "default": "No answer after 5 s: an endless loop?",
      "required": false,
      "docs": {
        "description": "Logged when the code started but the run did not finish within 5 seconds."
      }
    },
    {
      "name": "noRunnerLabel",
      "attribute": "no-runner-label",
      "type": "string",
      "default": "The runner did not answer",
      "required": false,
      "docs": {
        "description": "Logged when the runner page did not start the code within 5 seconds."
      }
    },
    {
      "name": "errorLabel",
      "attribute": "error-label",
      "type": "string",
      "default": "{message} (line {line})",
      "required": false,
      "docs": {
        "description": "Logged for an error with a line: {message} becomes the error, {line} its line."
      }
    }
  ],
  "slots": [
    {
      "name": "(files)",
      "description": "Child <script type=\"text/plain\" data-file=\"component.js|index.html|style.css\"> elements with the initial files."
    },
    {
      "name": "bar",
      "description": "Extra content for the top bar, between the file tabs and the run status (Starbase puts its live size line there)."
    }
  ],
  "events": [
    {
      "kind": "custom-event",
      "name": "sb-change",
      "bubbles": true,
      "composed": true,
      "description": "After an edit. detail: { files }."
    },
    {
      "kind": "custom-event",
      "name": "sb-run",
      "bubbles": true,
      "composed": true,
      "description": "When the preview is (re)started. detail: { files }."
    }
  ]
}
