package ui

import (
	"fmt"
	"strconv"

	"starbase/internal/catalog"
	"starbase/internal/queries"
)

type ComponentView struct {
	Card      queries.Card
	Component *catalog.Component
	Playground *catalog.Playground
	Install   string // highlighted install snippet (HTML)
	InstallRaw string
	ScriptURL string
	EditURL   string
}

templ ComponentPage(s Shell, v ComponentView) {
	<div class="wrap">
		<header class="page-head" style={ templ.SafeCSS("view-transition-name: card-" + v.Card.Slug) }>
			<nav class="breadcrumbs" aria-label="Breadcrumb">
				<a href="/">Components</a>
				<span aria-hidden="true">/</span>
				<a href={ browseHref(modelBrowseCategory(v.Card.Category)) }>{ categoryLabel(v.Card.Category) }</a>
			</nav>
			<h1>{ v.Card.Name }</h1>
			<p class="lede">{ v.Card.Summary }</p>
			<div class="meta-row cluster">
				<span class="author">
					<img class="avatar" src={ avatar(v.Card.Author) } alt="" width="24" height="24"/>
					<a href={ safe("https://github.com/" + v.Card.Author) }>{ v.Card.Author }</a>
				</span>
				<code>{ "<" + v.Card.Tag + ">" }</code>
				for _, t := range v.Card.Tags {
					<span class="tag-chip">{ t }</span>
				}
				<span class="muted">Since { v.Card.Since }</span>
				@StarButton(s, v.Card, true)
				<a class="btn btn--ghost btn--sm" href={ safe(v.EditURL) }>
					@Icon("pencil")
					Edit on GitHub
				</a>
			</div>
		</header>
		<div class="docs">
			<article class="prose">
				if v.Playground != nil {
					<h2 id="playground">Playground</h2>
					@Playground(v.Playground)
				}
				@templ.Raw(v.Component.DocHTML)
				<h2 id="installation">Installation</h2>
				<p>Load Datastar with Rocket once per page, then import the component module. Rocket is free and ships in the <code>datastar-rocket.js</code> bundle.</p>
				<div class="code-block">
					<sb-copy-button class="code-copy" value={ v.InstallRaw }></sb-copy-button>
					@templ.Raw(v.Install)
				</div>
				@APIReference(v.Component)
			</article>
			<aside>
				<nav class="toc" aria-label="On this page">
					<h2>On this page</h2>
					if v.Playground != nil {
						<a href="#playground">Playground</a>
					}
					for _, h := range v.Component.Headings {
						<a href={ safe("#" + h.ID) }>{ h.Text }</a>
					}
					<a href="#installation">Installation</a>
					<a href="#api">API reference</a>
				</nav>
			</aside>
		</div>
	</div>
}

templ APIReference(c *catalog.Component) {
	<h2 id="api">API reference</h2>
	if c.Manifest == nil {
		<p class="notice">
			@Icon("info")
			<span>No manifest yet. Run the dev server and open this page: Rocket publishes the component's props, slots and events, and the dev server writes <code>manifest.json</code>.</span>
		</p>
	} else {
		<h3 id="props">Props</h3>
		if len(c.Manifest.Props) == 0 {
			<p>This component takes no props.</p>
		} else {
			<div class="table-scroll">
				<table class="api-table">
					<thead><tr><th>Attribute</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
					<tbody>
						for _, p := range c.Manifest.Props {
							<tr>
								<td><code>{ p.Attribute }</code></td>
								<td>{ propType(p) }</td>
								<td><code>{ propDefault(p) }</code></td>
								<td>{ propDoc(p) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if len(c.Manifest.Slots) > 0 {
			<h3 id="slots">Slots</h3>
			<div class="table-scroll">
				<table class="api-table">
					<thead><tr><th>Name</th><th>Description</th></tr></thead>
					<tbody>
						for _, sl := range c.Manifest.Slots {
							<tr><td><code>{ sl.Name }</code></td><td>{ sl.Description }</td></tr>
						}
					</tbody>
				</table>
			</div>
		}
		if len(c.Manifest.Events) > 0 {
			<h3 id="events">Events</h3>
			<div class="table-scroll">
				<table class="api-table">
					<thead><tr><th>Name</th><th>Description</th></tr></thead>
					<tbody>
						for _, e := range c.Manifest.Events {
							<tr><td><code>{ e.Name }</code></td><td>{ e.Description }</td></tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

func bindAttr(c catalog.Control, mods string) templ.Attributes {
	return templ.Attributes{"data-bind:_pg." + c.Attr + mods: true}
}

func fmtNum(f float64) string { return strconv.FormatFloat(f, 'f', -1, 64) }

func initialString(c catalog.Control) string {
	switch v := c.Initial.(type) {
	case float64:
		return fmtNum(v)
	case nil:
		return ""
	default:
		return fmt.Sprint(v)
	}
}

// Playground is a client-side island: sliders and toggles steer the live
// element through local signals (never sent to the server), and server
// frames leave the whole section alone (data-ignore-morph).
templ Playground(pg *catalog.Playground) {
	<div class="playground" data-ignore-morph data-signals:_pg={ pg.Signals() }>
		<div class="playground__stage demo-stage">
			@templ.Raw(pg.Element())
		</div>
		<div class="playground__controls">
			for _, c := range pg.Controls {
				switch c.Kind {
					case catalog.ControlNumber:
						<sb-slider
							label={ c.Attr }
							title={ c.Description }
							min={ fmtNum(c.Min) }
							max={ fmtNum(c.Max) }
							step={ fmtNum(c.Step) }
							value={ initialString(c) }
							{ bindAttr(c, "__prop.value")... }
						></sb-slider>
					case catalog.ControlBool:
						<sb-toggle
							label={ c.Attr }
							title={ c.Description }
							size="sm"
							if c.Initial == true {
								checked
							}
							{ bindAttr(c, "__prop.checked__event.change")... }
						></sb-toggle>
					case catalog.ControlSelect:
						<label class="playground__select select-field" title={ c.Description }>
							<span>{ c.Attr }</span>
							<select { bindAttr(c, "")... }>
								for _, o := range c.Options {
									<option value={ o } selected?={ initialString(c) == o }>{ o }</option>
								}
							</select>
						</label>
					case catalog.ControlText:
						<sb-input
							label={ c.Attr }
							title={ c.Description }
							value={ initialString(c) }
							placeholder={ c.Description }
							{ bindAttr(c, "__prop.value__event.input")... }
						></sb-input>
				}
			}
		</div>
		<div class="code-block playground__code">
			<sb-copy-button class="code-copy" data-attr:value={ pg.Markup() }></sb-copy-button>
			<pre class="chroma"><code data-text={ pg.Markup() }></code></pre>
		</div>
	</div>
}
