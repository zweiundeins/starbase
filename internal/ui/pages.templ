package ui

import "starbase/internal/model"

type ThemePreview struct {
	Name string
	HTML string
}

type ThemesView struct {
	Theme    string
	CSS      string
	CSSHTML  string
	Previews []ThemePreview
}

func themeClick(slug string) string {
	return "el.classList.add('is-pending'); @post('/cmd/theme/" + slug + "')"
}

// swatch colours are illustrative only; the real tokens live in CSS.
var swatches = map[string][]string{
	"deep-space": {"#080D1D", "#141D32", "#8C6BFF", "#6EF59A", "#65BFFF"},
	"nebula":     {"#2A0F24", "#3B1733", "#E85A9C", "#FFB38A", "#F7C98B"},
	"terminal":   {"#050A06", "#0D1A10", "#39E07A", "#E5D25A", "#8FD9A8"},
	"daylight":   {"#FBFBFE", "#FFFFFF", "#6246EA", "#1E9E5A", "#2E7DD1"},
}

templ ThemesPage(v ThemesView) {
	<div class="wrap">
		<header class="page-head">
			<h1>Themes</h1>
			<p class="lede">Every component reads semantic design tokens, never raw colours. Swap the token set and everything restyles, even inside shadow DOM.</p>
		</header>
		<div class="stack" style="--gap: var(--sb-space-8); padding-block: var(--sb-space-10) var(--sb-space-16)">
			<div class="theme-picker" role="group" aria-label="Preview theme">
				for _, t := range model.PreviewThemes {
					<button
						type="button"
						class="theme-option"
						aria-pressed={ boolString(v.Theme == t.Slug) }
						data-on:click={ themeClick(t.Slug) }
					>
						<span class="swatches" aria-hidden="true">
							for _, c := range swatches[t.Slug] {
								<span style={ templ.SafeCSS("background:" + c) }></span>
							}
						</span>
						<strong>{ t.Label }</strong>
						<span>{ t.Blurb }</span>
					</button>
				}
			</div>
			<section class="theme-stage" data-sb-theme={ v.Theme } aria-label="Live preview">
				for _, p := range v.Previews {
					<div class="theme-stage__cell">
						<h3>{ p.Name }</h3>
						<div>
							@templ.Raw(p.HTML)
						</div>
					</div>
				}
			</section>
			<section class="prose">
				<h2>Use it</h2>
				<p>Scope a theme to any element with <code>data-sb-theme</code>, or copy the overrides into your own stylesheet. Components only ever read <code>--sb-*</code> semantic tokens.</p>
				<div class="code-block">
					<sb-copy-button class="code-copy" value={ v.CSS }></sb-copy-button>
					@templ.Raw(v.CSSHTML)
				</div>
			</section>
		</div>
	</div>
}

templ ContentPage(title, lede, html string, extra templ.Component) {
	<div class="wrap">
		<header class="page-head">
			<h1>{ title }</h1>
			if lede != "" {
				<p class="lede">{ lede }</p>
			}
		</header>
		if extra != nil {
			<div style="padding-block-start: var(--sb-space-10)">
				@extra
			</div>
		}
		<article class="prose" style="padding-block: var(--sb-space-10) var(--sb-space-16)">
			@templ.Raw(html)
		</article>
	</div>
}

templ NotFound() {
	<div class="wrap">
		<div class="empty-state" style="margin-block: var(--sb-space-16)">
			<h3>Lost in space</h3>
			<p>This page drifted out of orbit. Head back to base.</p>
			<a class="btn btn--primary btn--sm" href="/">Back to components</a>
		</div>
	</div>
}

// MissionControl is a live dashboard built only from community components.
// The server streams $_tm (telemetry) as signal patches; everything else is
// data-attr wiring. It is a client island: server frames leave it alone.
templ MissionControl() {
	<section
		class="mission"
		aria-labelledby="mission-title"
		data-ignore-morph
		data-signals="{_tm: {t: -8, stage: 'PAD', alt: 0, vel: 0, fuel: 100, temp: 18, pitch: 90}}"
		data-init="@get('/demo/telemetry')"
	>
		<header class="mission__head">
			<h2 id="mission-title" class="section-title">Mission Control</h2>
			<span class="mission__stage" data-text="$_tm.stage" data-attr:data-stage="$_tm.stage">PAD</span>
			<span class="mission__clock" data-text="($_tm.t < 0 ? 'T−' : 'T+') + Math.abs($_tm.t).toFixed(1) + ' s'">T−8.0 s</span>
		</header>
		<div class="mission__grid">
			<div class="mission__view">
				<sb-starfield tint="violet" density="420" data-attr:speed="Math.round(3 + $_tm.vel * 11)" data-attr:warp="$_tm.vel > 5"></sb-starfield>
				<sb-voxel model="rocket" spin="24" zoom="0.9" data-attr:pitch="Math.round(($_tm.pitch - 90) / 4)"></sb-voxel>
			</div>
			<div class="mission__panel">
				<div class="mission__gauges">
					<sb-gauge label="Velocity" unit=" km/s" min="0" max="8" warn="9" danger="10" decimals="2" data-attr:value="$_tm.vel"></sb-gauge>
					<sb-gauge label="Hull" unit="°C" min="0" max="1200" warn="800" danger="1000" data-attr:value="$_tm.temp"></sb-gauge>
				</div>
				<div class="mission__row">
					<span class="mission__caption">Altitude</span>
					<sb-sparkline data-attr:value="$_tm.alt" length="80" show-value unit=" km" tone="accent"></sb-sparkline>
				</div>
				<sb-meter label="Fuel" unit="%" warn="30" danger="15" segments="20" data-attr:value="Math.round($_tm.fuel)"></sb-meter>
			</div>
		</div>
		<details class="howto">
			<summary>How it works</summary>
			<div class="howto__body">
				<p>Built only from community components: <code>sb-starfield</code>, <code>sb-voxel</code>, <code>sb-gauge</code>, <code>sb-sparkline</code> and <code>sb-meter</code>. No custom JavaScript.</p>
				<ol>
					<li><code>{ "data-init=\"@get('/demo/telemetry')\"" }</code> opens a stream. Four times a second the server patches one signal, <code>$_tm</code>, with simulated telemetry. It's a pure function of the clock, so every viewer watches the same flight.</li>
					<li>Each component's attributes follow that signal through <code>data-attr</code>: <code>{ "data-attr:value=\"$_tm.vel\"" }</code>.</li>
					<li>The components only react to their attributes: the gauge springs its needle, the sparkline appends a point, the starfield speeds up.</li>
				</ol>
			</div>
		</details>
	</section>
}

type CodePlaygroundView struct {
	Initial       string // JSON files
	Deps          string // JSON {tag: module URL}
	Component     string // slug, when opened from a component page
	ComponentName string
	Loaded        string // snippet id from ?s=
	Author        string // snippet author (GitHub login), if any
	Share         string // snippet id to offer as a link
	ShareURL      string
}

func shareExpr(component string) string {
	return "el.classList.add('is-pending'); @post('/cmd/snippet', {payload: {tabid: $tabid, component: " + jsString(component) +
		", files: document.querySelector('sb-code-playground').files}})"
}

templ CodePlaygroundPage(v CodePlaygroundView) {
	<div class="wrap code-page">
		<header class="page-head page-head--compact">
			if v.Component != "" {
				<nav class="breadcrumbs" aria-label="Breadcrumb">
					<a href="/">Components</a>
					<span aria-hidden="true">/</span>
					<a href={ templ.SafeURL("/components/" + v.Component) }>{ v.ComponentName }</a>
					<span aria-hidden="true">/</span>
					<span>Playground</span>
				</nav>
			}
			<h1>Playground</h1>
			<p class="lede">
				if v.Component != "" {
					The real source of { v.ComponentName }, with its examples. Change anything; the preview runs in a sandbox.
				} else {
					Write a Rocket component and try it live. The preview runs in a sandbox with every community component available.
				}
			</p>
		</header>
		<div class="code-page__island" data-ignore-morph>
			<sb-code-playground initial={ v.Initial } deps={ v.Deps }></sb-code-playground>
		</div>
		<div class="code-page__actions">
			<button type="button" class="btn btn--primary btn--sm" data-on:click={ shareExpr(v.Component) }>
				@Icon("rocket")
				Save &amp; share
			</button>
			if v.Share != "" {
				<span>
					if v.Author != "" && v.Share == v.Loaded {
						By { v.Author } ·
					}
					Link:
				</span>
				<a href={ templ.SafeURL(v.ShareURL) }>{ v.ShareURL }</a>
				<sb-copy-button value={ v.ShareURL } label="Copy link"></sb-copy-button>
				<a class="btn btn--outline btn--sm" href={ templ.SafeURL("/submit?s=" + v.Share) }>
					@Icon("github")
					Submit as component
				</a>
			} else {
				<span class="muted">Saving creates a permanent link anyone can open. Then you can submit it as a component.</span>
			}
		</div>
	</div>
}

type BoardView struct {
	Cells   string
	Size    int
	Pixels  int64
	Viewers int
}

// Paint batches must not cancel each other (Datastar cancels in-flight
// requests to the same URL by default), or fast strokes would lose pixels.
const paintExpr = "@post('/cmd/paint', {payload: {color: evt.detail.color, cells: evt.detail.cells}, requestCancellation: 'disabled'})"

templ Showcase(board BoardView) {
	@MissionControl()
	@PixelBoard(board)
}

// PixelBoard is server-owned: every frame of the page's render stream brings
// the latest cells; painting is a command.
templ PixelBoard(v BoardView) {
	<section class="board-section" aria-labelledby="board-title">
		<header class="mission__head">
			<h2 id="board-title" class="section-title">Pixel Board</h2>
			<span class="board-stats" aria-live="polite">
				<span class="board-stats__dot" aria-hidden="true"></span>
				{ itoa(v.Viewers) } watching · { itoa(int(v.Pixels)) } pixels painted
			</span>
		</header>
		<div class="board-section__grid">
			<sb-pixel-board id="board" size={ itoa(v.Size) } cells={ v.Cells } data-on:sb-paint={ paintExpr }></sb-pixel-board>
			<div class="board-section__about">
				<p><strong>Paint together.</strong> Everyone on this page shares one 48×48 board. Pick a colour and drag.</p>
				<p class="muted">Faded pixels are still in flight. About 20 pixels per second each, so everybody gets a turn.</p>
			</div>
		</div>
		<details class="howto" data-preserve-attr="open">
			<summary>How it works</summary>
			<div class="howto__body">
				<p>The whole board is one attribute: <code>cells</code>, a string with one hex digit per pixel, rendered by the server into every frame of this page's stream.</p>
				<ol>
					<li>Your stroke emits <code>sb-paint</code>, which becomes a command: <code>{ "@post('/cmd/paint')" }</code>, answered with <code>204</code>.</li>
					<li>One writer applies everyone's pixels in a single SQLite transaction.</li>
					<li>Every open tab's stream re-renders the page, and the board's <code>cells</code> morphs in. Brotli compresses each frame against the ones before, so resending the whole board costs almost nothing. It's the trick behind Anders Murphy's hyperlith demos.</li>
				</ol>
			</div>
		</details>
	</section>
}
